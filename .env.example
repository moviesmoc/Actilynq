# Server Configuration
NODE_ENV=production
PORT=5000

# Client Origin (Set this to your live Render URL, e.g. https://actilynq.onrender.com)
CLIENT_ORIGIN=https://actilynq.onrender.com

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/actilynq_db?retryWrites=true&w=majority

# Authentication (Cryptographically generated 256-bit secret)
JWT_SECRET=your_jwt_secret_here_replace_with_random_hex_string

# Faculty Demo Dataset Seeding (true / false)
SEED_DEMO_DATA=true
DEMO_EMAIL=demo@actilynq.com
DEMO_PASSWORD=DemoPassword123!

# Google OAuth 2.0 Credentials (Both client and server)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Transactional Email (Choose Resend HTTP API for Render, or Gmail SMTP)
# Option A (Recommended for Render - 100% cloud deliverability over port 443 HTTPS):
# Sign up free at https://resend.com (3,000 emails/month free forever)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ActiLynq Travel CRM <onboarding@resend.dev>

# Option B (Nodemailer SMTP - Note: Render blocks/throttles raw port 465/587 to smtp.gmail.com):
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Optional: Set to true if MongoDB Atlas encounters TLS handshake issues on Render
MONGO_TLS_ALLOW_INVALID=false
